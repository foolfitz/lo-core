#include <com/sun/star/uno/XInterface.idl>
#include <com/sun/star/awt/XSplitListener.idl>

module com {  module sun {  module star {  module awt {

/** provides access to a draggable splitter bar for resizing
    adjacent areas.

    <p>Create via Toolkit::createWindow() with
    WindowDescriptor.WindowServiceName = "splitter".</p>

    @since LibreOffice 26.2
 */
published interface XSplitterWindow : com::sun::star::uno::XInterface
{
    /** adds a listener for splitter drag events. */
    void addSplitListener(
        [in] com::sun::star::awt::XSplitListener xListener );

    /** removes a previously added split listener. */
    void removeSplitListener(
        [in] com::sun::star::awt::XSplitListener xListener );

    /** sets the splitter position in pixels. */
    void setSplitPosition( [in] long nPos );

    /** returns the current splitter position in pixels. */
    long getSplitPosition();

    /** sets the orientation.

        @param bHorizontal
            TRUE for a splitter whose position moves along the X axis
            (dragged left/right), FALSE for one whose position moves
            along the Y axis (dragged up/down).
     */
    void setHorizontal( [in] boolean bHorizontal );

    /** returns TRUE if the splitter moves along the X axis. */
    boolean getHorizontal();

    /** sets the minimum and maximum draggable range along the drag axis.

        @param nMin minimum position in pixels
        @param nMax maximum position in pixels
     */
    void setRange( [in] long nMin, [in] long nMax );
};

}; }; }; };

